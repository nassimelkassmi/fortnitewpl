{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "database.ts",
    "index.ts",
    "interfaces.ts",
    "middlewares/secureMiddlewares.ts",
    "session.ts"
  ],
  "exclude": ["node_modules"]
}
