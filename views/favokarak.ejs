<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= karakter.name %> — Favoriet</title>
  <link rel="stylesheet" href="/css/favokarak.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bangers&display=swap">
</head>
<body>
  <header class="navbar">
    <div class="left">
      <a href="/personages" class="back-btn">←</a>
    </div>
    <div class="center">
      <nav>
        <span class="navbar-title">KARAKTER</span>
      </nav>
    </div>
    <div class="right">
      <div class="user-info">
        <img id="user-profile-img" src="<%= avatarImage || '/assets/question-mark.svg' %>" alt="User" class="user-profile" />
        <span class="username"><%= username %></span>
        <button class="info-btn">ℹ️</button>
      </div>
    </div>
  </header>

  <main class="karakter-container">
    <div class="karakter-content">
      <div class="karakter-img-wrapper">
        <span class="favorite-star">⭐</span>
        <img src="<%= karakter.image %>" alt="<%= karakter.name %>">
      </div>
      <div class="karakter-details">
        <h1><%= karakter.name %></h1>
        <p><%= karakter.description %></p>

        <form class="stats" method="POST" action="/score/<%= karakter.id %>">
          <input type="hidden" name="name" value="<%= karakter.name %>">
          <input type="hidden" name="image" value="<%= karakter.image %>">

          <p>🏆 Wins: <input type="number" name="wins" value="<%= karakter.wins %>" required></p>
          <p>💀 Losses: <input type="number" name="losses" value="<%= karakter.losses %>" required></p>
          <button type="submit">📈 Update score</button>
        </form>
      </div>
    </div>

    <div class="item-shop">
      <h2>🎁 Geselecteerde Items (max. 2)</h2>
      <form method="POST" action="/items/<%= karakter.id %>">
        <div class="selected-items">
          <% for (let i = 0; i < 2; i++) { %>
            <div class="item-slot">
              <% const item = karakter.items?.[i]; %>
              <img src="<%= item ? item : '/assets/placeholder.png' %>" alt="Item <%= i + 1 %>">
            </div>
          <% } %>
        </div>
        <label>Items (icon-URLs of namen):</label>
        <input type="text" name="items" value="<%= karakter.items?.join(', ') || '' %>" placeholder="item1.png, item2.png">
        <button type="submit">💾 Opslaan</button>
      </form>
    </div>

    <div class="notes">
      <h2>📝 Notities</h2>
      <form method="POST" action="/notities/<%= karakter.id %>">
        <% if (karakter.notes && karakter.notes.length > 0) { %>
          <div id="notes-list">
            <p><%= karakter.notes[0] %></p>
          </div>
        <% } %>
        <textarea name="note" placeholder="Schrijf hier je notitie..."><%= karakter.notes?.[0] || '' %></textarea>
        <button type="submit">💾 Opslaan</button>
      </form>

      <form method="POST" action="/favorieten/<%= karakter.id %>/verwijder">
        <button class="remove-favorite">💔 Verwijder uit favorieten</button>
      </form>
    </div>
  </main>

  <div id="popup-message" class="popup-message"></div>
</body>
</html>
