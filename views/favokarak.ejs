<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= karakter.name %> — Favoriet</title>
  <link rel="stylesheet" href="/css/favokarak.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bangers&display=swap">
</head>
<body>
  <main class="karakter-blok">
    <!-- TOP SECTION -->
    <section class="top-section">
      <a href="/personages" class="back-btn">←</a>
      <h1>KARAKTER INFO</h1>
    </section>

    <!-- KARAKTER INFO GRID -->
    <div class="karakter-grid">
      <!-- LINKERKANT: FOTO + ITEMS -->
      <div class="karakter-left">
        <div class="karakter-img-wrapper">
          <span class="favorite-star">⭐</span>
          <img src="<%= karakter.image %>" alt="<%= karakter.name %>">
        </div>
        <div class="item-shop">
          <div class="itemshop-label">Loadout</div>
          <div class="selected-items">
            <% for (let i = 0; i < 2; i++) { %>
              <div class="big-item-card">
                <img src="<%= karakter.items?.[i] ? karakter.items[i] : '/assets/placeholder.png' %>" alt="Item <%= i + 1 %>">
                <form method="GET" action="/items/<%= karakter.id %>">
                  <input type="hidden" name="slot" value="<%= i + 1 %>">
                  <button type="submit" class="loadout-plus-btn" aria-label="Kies item">+</button>
                </form>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- RECHTS: NAAM, STATS EN NOTITIES -->
      <div class="karakter-right">
        <div class="karakter-details">
          <h1><%= karakter.name %></h1>
          <div class="karakter-set"><%= karakter.set %></div>
          <p><%= karakter.description %></p>
        </div>

        <div class="stats-row">
          <!-- Wins -->
          <form method="POST" action="/score/<%= karakter.id %>" class="stat-card">
            <button name="wins" value="<%= karakter.wins - 1 %>" class="stat-btn">-</button>
            <span class="stat-value"><span>🏆</span> <b>Wins:</b> <%= karakter.wins %></span>
            <button name="wins" value="<%= karakter.wins + 1 %>" class="stat-btn">+</button>
            <input type="hidden" name="name" value="<%= karakter.name %>">
            <input type="hidden" name="image" value="<%= karakter.image %>">
            <input type="hidden" name="losses" value="<%= karakter.losses %>">
          </form>
          <!-- Losses -->
          <form method="POST" action="/score/<%= karakter.id %>" class="stat-card">
            <button name="losses" value="<%= karakter.losses - 1 %>" class="stat-btn">-</button>
            <span class="stat-value"><span>💀</span> <b>Losses:</b> <%= karakter.losses %></span>
            <button name="losses" value="<%= karakter.losses + 1 %>" class="stat-btn">+</button>
            <input type="hidden" name="name" value="<%= karakter.name %>">
            <input type="hidden" name="image" value="<%= karakter.image %>">
            <input type="hidden" name="wins" value="<%= karakter.wins %>">
          </form>
        </div>

        <!-- Notities en hartknop op 1 lijn, hartknop rechts groot -->
        <div class="notes-and-heart">
          <div class="notes">
            <h2>📝 Notities</h2>
            <div id="notes-list">
              <% if (karakter.notes && karakter.notes.length > 0) { %>
                <% karakter.notes.forEach(function(note, idx) { %>
                  <form method="POST" action="/notities/<%= karakter.id %>/verwijder/<%= idx %>" style="display:flex;align-items:center;">
                    <p style="flex:1;margin:0;"><%= note %></p>
                    <button type="submit" class="delete-note" style="margin-left:8px;">🗑️</button>
                  </form>
                <% }) %>
              <% } %>
            </div>
            <form class="note-form-row" method="POST" action="/notities/<%= karakter.id %>">
              <textarea name="note" placeholder="Schrijf hier je notitie..."></textarea>
              <button type="submit" class="note-save-btn">💾</button>
            </form>
          </div>
          <form method="POST" action="/favorieten/<%= karakter.id %>/verwijder" class="heart-form">
            <button class="remove-favorite-heart" type="submit" title="Verwijder uit favorieten">💔</button>
          </form>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
