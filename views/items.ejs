<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Item Winkel</title>
  <link rel="stylesheet" href="/css/items.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bangers&display=swap">
</head>
<body>
  <header class="navbar">
    <div class="left">
      <a href="/personages/<%= karakterID %>" class="back-btn">←</a>
    </div>
    <div class="center">
      <nav>
        <span class="navbar-title">ITEM WINKEL</span>
      </nav>
    </div>
    <div class="right">
      <div class="user-info">
        <img src="<%= avatarImage || '/assets/question-mark.svg' %>" alt="User" class="user-profile" />
        <span class="username"><%= username %></span>
        <button class="info-btn" onclick="showInfo()">ℹ️</button>
      </div>
    </div>
  </header>

  <main class="items-section">
    <h1>Kies een item</h1>
    <div class="items-grid">
      <!-- Wapens -->
      <div class="item-category">
        <h2>Wapens</h2>
        <form method="GET" action="/items/<%= karakterID %>">
          <select name="weaponsRarity" onchange="this.form.submit()">
            <option value="">ALLE RARITIES</option>
            <% rarities.forEach(r => { %>
              <option value="<%= r %>" <%= weaponsRarity === r ? "selected" : "" %>><%= r.toUpperCase() %></option>
            <% }) %>
          </select>
        </form>
        <div class="grid-column">
          <% weapons.forEach((w, idx) => { %>
            <form method="POST" action="/items/<%= karakterID %>?slot=1">
              <input type="hidden" name="items" value="<%= w.id %>">
              <div class="item-card" style="background-color: <%= getRarityColor(w.rarity.value) %>">
                <span class="rarity-label"><%= w.rarity.value.toUpperCase() %></span>
                <img src="<%= w.images.icon %>" alt="<%= w.name %>">
                <h3><%= w.name %></h3>
                <button type="submit" class="select-item">+</button>
              </div>
            </form>
          <% }) %>
        </div>
      </div>
      <!-- Emotes -->
      <div class="item-category">
        <h2>Emotes</h2>
        <form method="GET" action="/items/<%= karakterID %>">
          <select name="emotesRarity" onchange="this.form.submit()">
            <option value="">ALLE RARITIES</option>
            <% rarities.forEach(r => { %>
              <option value="<%= r %>" <%= emotesRarity === r ? "selected" : "" %>><%= r.toUpperCase() %></option>
            <% }) %>
          </select>
        </form>
        <div class="grid-column">
          <% emotes.forEach((e, idx) => { %>
            <form method="POST" action="/items/<%= karakterID %>?slot=2">
              <input type="hidden" name="items" value="<%= e.id %>">
              <div class="item-card" style="background-color: <%= getRarityColor(e.rarity.value) %>">
                <span class="rarity-label"><%= e.rarity.value.toUpperCase() %></span>
                <img src="<%= e.images.icon %>" alt="<%= e.name %>">
                <h3><%= e.name %></h3>
                <button type="submit" class="select-item">+</button>
              </div>
            </form>
          <% }) %>
        </div>
      </div>
      <!-- Back Blings -->
      <div class="item-category">
        <h2>Back Blings</h2>
        <form method="GET" action="/items/<%= karakterID %>">
          <select name="backblingsRarity" onchange="this.form.submit()">
            <option value="">ALLE RARITIES</option>
            <% rarities.forEach(r => { %>
              <option value="<%= r %>" <%= backblingsRarity === r ? "selected" : "" %>><%= r.toUpperCase() %></option>
            <% }) %>
          </select>
        </form>
        <div class="grid-column">
          <% backblings.forEach((b, idx) => { %>
            <form method="POST" action="/items/<%= karakterID %>?slot=2">
              <input type="hidden" name="items" value="<%= b.id %>">
              <div class="item-card" style="background-color: <%= getRarityColor(b.rarity.value) %>">
                <span class="rarity-label"><%= b.rarity.value.toUpperCase() %></span>
                <img src="<%= b.images.icon %>" alt="<%= b.name %>">
                <h3><%= b.name %></h3>
                <button type="submit" class="select-item">+</button>
              </div>
            </form>
          <% }) %>
        </div>
      </div>
    </div>
  </main>
  <script>
    function showInfo() {
      const msg = document.createElement('div');
      msg.className = 'popup-message';
      msg.textContent = 'Klik op + om een item toe te voegen aan het gekozen slot!';
      document.body.appendChild(msg);
      setTimeout(() => msg.remove(), 2000);
    }
  </script>
</body>
</html>
