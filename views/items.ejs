<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Item Winkel</title>
  <link rel="stylesheet" href="/css/items.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bangers&display=swap">
</head>
<body>
  <!-- Navbar met left/center/right structuur -->
  <header class="navbar">
    <div class="left">
      <a href="/personages/<%= karakterID %>" class="back-btn">←</a>
    </div>
    <div class="center">
      <nav>
        <span class="navbar-title">ITEM WINKEL</span>
      </nav>
    </div>
    <div class="right">
      <div class="user-info">
        <img src="<%= avatarImage || '/assets/question-mark.svg' %>" alt="User" class="user-profile" />
        <span class="username"><%= username %></span>
        <button class="info-btn">ℹ️</button>
      </div>
    </div>
  </header>

  <!-- Main container -->
  <main class="items-section">
    <h1>Kies een item</h1>
    <form method="POST" action="/items/<%= karakterID %>">
      <div class="items-grid">
        <div class="item-category">
          <h2>Wapens</h2>
          <div class="grid-column">
            <% weapons.forEach(w => { %>
              <label>
                <input type="checkbox" name="items" value="<%= w.id %>">
                <img src="<%= w.images.icon %>" alt="<%= w.name %>">
                <span><%= w.name %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="item-category">
          <h2>Emotes</h2>
          <div class="grid-column">
            <% emotes.forEach(e => { %>
              <label>
                <input type="checkbox" name="items" value="<%= e.id %>">
                <img src="<%= e.images.icon %>" alt="<%= e.name %>">
                <span><%= e.name %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="item-category">
          <h2>Back Blings</h2>
          <div class="grid-column">
            <% backblings.forEach(b => { %>
              <label>
                <input type="checkbox" name="items" value="<%= b.id %>">
                <img src="<%= b.images.icon %>" alt="<%= b.name %>">
                <span><%= b.name %></span>
              </label>
            <% }) %>
          </div>
        </div>
      </div>
      <button type="submit">Opslaan</button>
    </form>
  </main>
</body>
</html>