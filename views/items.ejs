<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Item Winkel</title>
  <link rel="stylesheet" href="/css/items.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bangers&display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

</head>
<body>
  <header class="navbar">
    <div class="left">
      <a href="/personages/<%= karakterID %>" class="back-btn">←</a>
    </div>
    <div class="center">
      <nav>
        <span class="navbar-title">ITEM WINKEL</span>
      </nav>
    </div>
    <div class="right">
      <div class="user-info">
        <img src="<%= avatarImage && avatarImage.trim() !== '' ? avatarImage : '/assets/question-mark.svg' %>" alt="User" class="user-profile" />
        <span class="username"><%= username %></span>
        <button class="info-btn" onclick="showInfo()">ℹ️</button>
      </div>
    </div>
  </header>

  <main class="items-section">
    <h1>Kies een item</h1>
    <div class="items-grid">

      <!-- WAPENS -->
      <div class="item-category">
        <h2>Wapens</h2>
        <form method="GET" action="/items/<%= karakterID %>">
          <input type="hidden" name="slot" value="<%= slot %>">
          <select name="weaponsRarity" onchange="this.form.submit()">
            <option value="">ALLE RARITIES</option>
            <option value="common" <%= weaponsRarity === 'common' ? 'selected' : '' %>>COMMON</option>
            <option value="uncommon" <%= weaponsRarity === 'uncommon' ? 'selected' : '' %>>UNCOMMON</option>
            <option value="rare" <%= weaponsRarity === 'rare' ? 'selected' : '' %>>RARE</option>
            <option value="epic" <%= weaponsRarity === 'epic' ? 'selected' : '' %>>EPIC</option>
            <option value="legendary" <%= weaponsRarity === 'legendary' ? 'selected' : '' %>>LEGENDARY</option>
            <option value="other" <%= weaponsRarity === 'other' ? 'selected' : '' %>>OTHER</option>
          </select>
          <input type="hidden" name="emotesRarity" value="<%= emotesRarity %>">
          <input type="hidden" name="backblingsRarity" value="<%= backblingsRarity %>">
        </form>
        <div class="carousel-pagination-numbers weapons"></div>
        <div class="carousel-row">
          <button class="carousel-arrow left carousel-prev weapons" aria-label="Vorige">
            <span class="arrow">&#x25C0;</span>
          </button>
          <div class="grid-column weapons">
            <% weapons.forEach(w => { %>
              <% if (w.images && w.images.icon && w.images.icon.endsWith('.png')) { %>
                <form method="POST" action="/items/<%= karakterID %>" class="item-card" style="background-color: <%= w.bgColor %>">
                  <input type="hidden" name="items" value="<%= w.id %>">
                  <input type="hidden" name="slot" value="<%= slot %>">
                  <span class="rarity-label"><%= w.rarityLabel %></span>
                  <img src="<%= w.images.icon %>" alt="<%= w.name %>">
                  <h3><%= w.name %></h3>
                  <button type="submit" class="select-item">+</button>
                </form>
              <% } %>
            <% }) %>
          </div>
          <button class="carousel-arrow right carousel-next weapons" aria-label="Volgende">
            <span class="arrow">&#x25B6;</span>
          </button>
        </div>
      </div>

      <!-- EMOTES -->
      <div class="item-category">
        <h2>Emotes</h2>
        <form method="GET" action="/items/<%= karakterID %>">
          <input type="hidden" name="slot" value="<%= slot %>">
          <select name="emotesRarity" onchange="this.form.submit()">
            <option value="">ALLE RARITIES</option>
            <option value="common" <%= emotesRarity === 'common' ? 'selected' : '' %>>COMMON</option>
            <option value="uncommon" <%= emotesRarity === 'uncommon' ? 'selected' : '' %>>UNCOMMON</option>
            <option value="rare" <%= emotesRarity === 'rare' ? 'selected' : '' %>>RARE</option>
            <option value="epic" <%= emotesRarity === 'epic' ? 'selected' : '' %>>EPIC</option>
            <option value="legendary" <%= emotesRarity === 'legendary' ? 'selected' : '' %>>LEGENDARY</option>
            <option value="other" <%= emotesRarity === 'other' ? 'selected' : '' %>>OTHER</option>
          </select>
          <input type="hidden" name="weaponsRarity" value="<%= weaponsRarity %>">
          <input type="hidden" name="backblingsRarity" value="<%= backblingsRarity %>">
        </form>
        <div class="carousel-pagination-numbers emotes"></div>
        <div class="carousel-row">
          <button class="carousel-arrow left carousel-prev emotes" aria-label="Vorige">
            <span class="arrow">&#x25C0;</span>
          </button>
          <div class="grid-column emotes">
            <% emotes.forEach(e => { %>
              <% if (e.images && e.images.icon && e.images.icon.endsWith('.png')) { %>
                <form method="POST" action="/items/<%= karakterID %>" class="item-card" style="background-color: <%= e.bgColor %>">
                  <input type="hidden" name="items" value="<%= e.id %>">
                  <input type="hidden" name="slot" value="<%= slot %>">
                  <span class="rarity-label"><%= e.rarityLabel %></span>
                  <img src="<%= e.images.icon %>" alt="<%= e.name %>">
                  <h3><%= e.name %></h3>
                  <button type="submit" class="select-item">+</button>
                </form>
              <% } %>
            <% }) %>
          </div>
          <button class="carousel-arrow right carousel-next emotes" aria-label="Volgende">
            <span class="arrow">&#x25B6;</span>
          </button>
        </div>
      </div>

      <!-- BACK BLINGS -->
      <div class="item-category">
        <h2>Back Blings</h2>
        <form method="GET" action="/items/<%= karakterID %>">
          <input type="hidden" name="slot" value="<%= slot %>">
          <select name="backblingsRarity" onchange="this.form.submit()">
            <option value="">ALLE RARITIES</option>
            <option value="common" <%= backblingsRarity === 'common' ? 'selected' : '' %>>COMMON</option>
            <option value="uncommon" <%= backblingsRarity === 'uncommon' ? 'selected' : '' %>>UNCOMMON</option>
            <option value="rare" <%= backblingsRarity === 'rare' ? 'selected' : '' %>>RARE</option>
            <option value="epic" <%= backblingsRarity === 'epic' ? 'selected' : '' %>>EPIC</option>
            <option value="legendary" <%= backblingsRarity === 'legendary' ? 'selected' : '' %>>LEGENDARY</option>
            <option value="other" <%= backblingsRarity === 'other' ? 'selected' : '' %>>OTHER</option>
          </select>
          <input type="hidden" name="weaponsRarity" value="<%= weaponsRarity %>">
          <input type="hidden" name="emotesRarity" value="<%= emotesRarity %>">
        </form>
        <div class="carousel-pagination-numbers backblings"></div>
        <div class="carousel-row">
          <button class="carousel-arrow left carousel-prev backblings" aria-label="Vorige">
            <span class="arrow">&#x25C0;</span>
          </button>
          <div class="grid-column backblings">
            <% backblings.forEach(b => { %>
              <% if (b.images && b.images.icon && b.images.icon.endsWith('.png')) { %>
                <form method="POST" action="/items/<%= karakterID %>" class="item-card" style="background-color: <%= b.bgColor %>">
                  <input type="hidden" name="items" value="<%= b.id %>">
                  <input type="hidden" name="slot" value="<%= slot %>">
                  <span class="rarity-label"><%= b.rarityLabel %></span>
                  <img src="<%= b.images.icon %>" alt="<%= b.name %>">
                  <h3><%= b.name %></h3>
                  <button type="submit" class="select-item">+</button>
                </form>
              <% } %>
            <% }) %>
          </div>
          <button class="carousel-arrow right carousel-next backblings" aria-label="Volgende">
            <span class="arrow">&#x25B6;</span>
          </button>
        </div>
      </div>
    </div>
    <div id="popup-message" class="popup-message"></div>
  </main>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const ITEMS_PER_PAGE = 4;
  const MAX_PAGE_BUTTONS = 4;
  ['weapons', 'emotes', 'backblings'].forEach(type => {
    const grid = document.querySelector(`.grid-column.${type}`);
    const prevBtn = document.querySelector(`.carousel-arrow.carousel-prev.${type}`);
    const nextBtn = document.querySelector(`.carousel-arrow.carousel-next.${type}`);
    const numbersDiv = document.querySelector(`.carousel-pagination-numbers.${type}`);
    const allItems = Array.from(grid.querySelectorAll('.item-card'));
    let currentPage = 1;
    const totalPages = Math.max(1, Math.ceil(allItems.length / ITEMS_PER_PAGE));

    function showPage(page) {
      allItems.forEach((el, i) => {
        el.style.display = (i >= (page - 1) * ITEMS_PER_PAGE && i < page * ITEMS_PER_PAGE) ? '' : 'none';
      });
      numbersDiv.innerHTML = "";
      function addBtn(text, pageNum, active = false) {
        let btn = document.createElement('button');
        btn.textContent = text;
        btn.className = "carousel-page" + (active ? " active" : "");
        if (!active) btn.onclick = () => { currentPage = pageNum; showPage(currentPage); };
        numbersDiv.appendChild(btn);
      }
      function addEllipsis() {
        let el = document.createElement('span');
        el.textContent = "...";
        el.className = "carousel-ellipsis";
        numbersDiv.appendChild(el);
      }
      if (totalPages <= MAX_PAGE_BUTTONS) {
        for (let i = 1; i <= totalPages; i++) {
          addBtn(i, i, i === page);
        }
      } else {
        if (page <= 2) {
          for (let i = 1; i <= 2; i++) addBtn(i, i, i === page);
          addEllipsis();
          addBtn(totalPages, totalPages, page === totalPages);
        } else if (page >= totalPages - 1) {
          addBtn(1, 1, page === 1);
          addEllipsis();
          for (let i = totalPages - 1; i <= totalPages; i++) addBtn(i, i, i === page);
        } else {
          addBtn(1, 1, page === 1);
          addEllipsis();
          addBtn(page, page, true);
          addEllipsis();
          addBtn(totalPages, totalPages, page === totalPages);
        }
      }
      prevBtn.disabled = page === 1;
      nextBtn.disabled = page === totalPages;
    }
    prevBtn.onclick = () => { if (currentPage > 1) { currentPage--; showPage(currentPage); }};
    nextBtn.onclick = () => { if (currentPage < totalPages) { currentPage++; showPage(currentPage); }};
    showPage(currentPage);
  });
});
</script>
<script>
  function showInfo() {
    const popup = document.getElementById('popup-message');
    popup.textContent = "Klik op een item om hem toe te voegen aan je favoriet karakter!";
    popup.classList.add('show');
    setTimeout(() => popup.classList.remove('show'), 3000);
  }
</script>
</body>
</html>
