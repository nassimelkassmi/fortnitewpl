<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Favoriete Personages</title>
  <link rel="stylesheet" href="/css/favoriet.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>
  <div class="navbar">
    <div class="left">
      <img src="/assets/logoFN.png" class="logo" alt="Logo" />
    </div>
    <div class="center">
      <nav>
        <a href="/personages" class="nav-btn">Personages</a>
        <a href="/favorieten" class="nav-btn active">Favorieten</a>
        <a href="/blacklist" class="nav-btn">Zwarte Lijst</a>
      </nav>
    </div>
    <div class="right">
      <div class="user-info">
      <img src="<%= avatarImage && avatarImage.trim() !== '' ? avatarImage : '/assets/question-mark.svg' %>" alt="User" class="user-profile" />

        <span class="username"><%= username || "Gebruikersnaam" %></span>
        <button class="info-btn">ℹ️</button>
      </div>
    </div>
  </div>

  <main>
    <!-- Bovenste section: titel, zoekveld, play-knop en filter dropdown -->
    <section class="top-section">
      <div class="top-container">
        <h1>Favorieten</h1>
      <form method="GET" action="/favorieten" class="search-container">
  <input 
    type="text" 
    id="search" 
    name="zoek" 
    placeholder="Zoek" 
    value="<%= zoek || '' %>">
  <button class="play-btn" type="submit">Play</button>
  <select name="rarity" id="filter-rarity" onchange="this.form.submit()">

    <option value="">Alle Zeldzaamheden</option>
    <option value="common" <%= rarity==='common'?'selected':'' %>>Common</option>
    <option value="uncommon" <%= rarity==='uncommon'?'selected':'' %>>Uncommon</option>
    <option value="rare" <%= rarity==='rare'?'selected':'' %>>Rare</option>
    <option value="epic" <%= rarity==='epic'?'selected':'' %>>Epic</option>
    <option value="legendary" <%= rarity==='legendary'?'selected':'' %>>Legendary</option>
    <option value="other" <%= rarity==='other'?'selected':'' %>>Overige</option>
  </select>
</form>

      </div>
    </section>

    <!-- Onderste section: grid met favoriete personages -->
    <section class="characters-section">
      <div class="characters-grid">
        <% favorites.forEach(character => { %>
          <a href="/personages/<%= character.id %>" class="character-card rarity-<%= character.rarity %>">
            <span class="favorite-star">⭐</span>
            <img src="<%= character.image %>" alt="<%= character.name %>">
            <div class="character-info">
              <h3><%= character.name %></h3>
            </div>
          </a>
        <% }) %>
      </div>
    </section>

    <!-- Popup voor meldingen (optioneel, via server) -->
    <% if (popupMessage) { %>
      <div id="popup-message" class="popup-message show"><%= popupMessage %></div>
    <% } %>
  </main>

  <footer>
    &copy; Code Ninjas | AP Hogeschool
  </footer>
</body>
</html>
