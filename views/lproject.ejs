<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fortnite Landing Page</title>
  <link rel="stylesheet" href="/css/lproject.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono&family=Roboto&display=swap" rel="stylesheet">
</head>

<body>
  <header>
    <img src="/assets/logoFN.png" alt="Code Ninjas Logo" class="logo">
  </header>

  <div class="landing-container">
    <h1 class="username">
    <img src="<%= avatarImage && avatarImage.trim() !== '' ? avatarImage : '/assets/question-mark.svg' %>" alt="Profielfoto" class="profile-pic">

      <span><%= username || "USERNAME" %></span>
    </h1>

    <div class="buttons">
      <form action="/logout" method="GET" style="display:inline;">
        <button class="logout-btn" type="submit">LOG UIT</button>
      </form>
      <button class="play-btn"><a href="/personages">PLAY</a></button>
    </div>

    <footer>
      &copy; Code Ninjas | AP Hogeschool
    </footer>
  </div>
</body>
</html>
