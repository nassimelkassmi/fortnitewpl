<!DOCTYPE html>
<html lang="nl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Landing Page</title>
  <link rel="stylesheet" href="/css/landingpage.css">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;300;400;500;700;900&display=swap" rel="stylesheet">
</head>

<body>
  <header>
    <img src="/assets/logoFN.png" alt="Code Ninjas Logo" class="logo">

    <% if (!username) { %>
      <div id="login_register" class="auth-buttons">
        <button onclick="window.location.href='/login'">Inloggen</button>
        <button class="nav-register-btn" onclick="window.location.href='/registreren'">Registreren</button>
      </div>
    <% } else { %>
      <div id="profiel">
        <span id="profiel_name"><%= username %></span>
        <form method="GET" action="/logout">
          <button id="log_out" type="submit">Log uit</button>
        </form>
      </div>
    <% } %>
  </header>

  <main class="grid-container">
    <div class="game">
      <div class="game-image-container">
        <a href="/lproject"><img src="/assets/fortoepic.jpg" alt="Fortnite"></a>
      </div>
      <div class="game-text-container">
        <a href="/lproject">
          <h2>Fortnite</h2>
        </a>
        <a href="/lproject"><button class="play-btn">▶ &nbsp;Start</button></a>
      </div>
    </div>

    <div class="game">
      <img src="/assets/eafc25pic.jpg" alt="FIFA">
      <div class="game-text-container">
        <h2>FIFA</h2>
        <button class="play-btn">▶ &nbsp;Start</button>
      </div>
    </div>

    <div class="game">
      <img src="/assets/lord-of-the-rings.jpg" alt="Lord of the Rings">
      <div class="game-text-container">
        <h2>Lord of The Rings</h2>
        <button class="play-btn">▶ &nbsp;Start</button>
      </div>
    </div>

    <div class="game">
      <img src="/assets/pokemon.jpg" alt="Pokemon">
      <div class="game-text-container">
        <h2>Pokemon</h2>
        <button class="play-btn">▶ &nbsp;Start</button>
      </div>
    </div>

    <div class="game">
      <img src="/assets/lego-masters.jpg" alt="Lego Masters">
      <div class="game-text-container">
        <h2>Lego Masters</h2>
        <button class="play-btn">▶ &nbsp;Start</button>
      </div>
    </div>

    <div class="game">
      <img src="/assets/magic the gathering.jpg" alt="Magic The Gathering">
      <div class="game-text-container">
        <h2>Magic The Gathering</h2>
        <button class="play-btn">▶ &nbsp;Start</button>
      </div>
    </div>
  </main>

  <footer>
    <p>© Code Ninjas | AP Hogeschool</p>
  </footer>

  <script type="module" src="/js/landingpage.js"></script>
</body>
</html>
