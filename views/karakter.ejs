<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Karakter Informatie</title>
  <link rel="stylesheet" href="/css/karakter.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono&family=Roboto:wght@100;400;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- NAVBAR -->
  <header class="navbar">
    <div class="left">
      <a href="/personages" class="back-btn">←</a>
    </div>
    <div class="center">
      <nav>
        <img src="/assets/logoFN.png" class="logo" alt="Logo" />
      </nav>
    </div>
    <div class="right">
      <div class="user-info">
        <img src="<%= avatarImage || '/assets/question-mark.svg' %>" alt="User" class="user-profile" />
        <span class="username"><%= username %></span>
        <form method="GET" action="/logout">
          <button class="info-btn" title="Uitloggen">⎋</button>
        </form>
      </div>
    </div>
  </header>

  <!-- BLAUWE BALK BOVEN VAK -->
  <section class="top-section">
    <h1>KARAKTER INFO</h1>
  </section>

  <!-- INHOUD VAN KARAKTER -->
  <main class="karakter-container">
    <div class="karakter-info">
      <div class="karakter-img-box">
        <span class="favorite-star" data-id="<%= karakter.id %>">⭐</span>
        <img class="rarity-<%= karakter.rarity.toLowerCase() %>" src="<%= karakter.image %>" alt="Karakter Afbeelding" />
      </div>
      <div class="karakter-text-box">
        <h1 id="karakter-naam"><%= karakter.name %></h1>
        <p id="karakter-beschrijving"><%= karakter.description %></p>

        <div class="extra-info">
          <p><strong>Zeldzaamheid:</strong> <span class="rarity-<%= karakter.rarity.toLowerCase() %>"><%= karakter.rarity %></span></p>
          <p><strong>Set:</strong> <%= karakter.set %></p>
          <p><strong>Releasedatum:</strong> <%= karakter.releaseDate %></p>
        </div>

        <div class="karakter-actions">
          <button type="button"
            class="blacklist-btn"
            data-id="<%= karakter.id %>"
            data-name="<%= karakter.name %>"
            data-img="<%= karakter.image %>">❌</button>

          <button type="button"
            class="favorite-btn"
            data-id="<%= karakter.id %>"><%= isFavoriet ? '💔' : '❤️' %></button>

          <button type="button"
            class="set-profile"
            data-id="<%= karakter.id %>"
            data-img="<%= karakter.image %>">
            <img src="<%= (avatarImage === karakter.image) ? '/assets/delete.png' : '/assets/add-user.png' %>" alt="Set profiel" />
          </button>
        </div>
      </div>
    </div>
  </main>

  <!-- Popup voor feedback -->
  <div id="popup-message" class="popup-message"></div>

  <!-- Blacklist reden popup (initieel verborgen) -->
  <div id="blacklist-reason" class="blacklist-reason">
    <p>Reden voor de zwarte lijst:</p>
    <input type="text" id="blacklist-input" placeholder="Geef een reden..." />
    <button id="submit-blacklist">Verstuur</button>
  </div>

  <script src="/js/popup.js"></script>
</body>
</html>
