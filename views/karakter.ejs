<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Karakter Informatie</title>
  <link rel="stylesheet" href="/css/karakter.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono&family=Roboto:wght@100;400;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- NAVBAR -->
  <header class="navbar">
    <div class="left">
      <a href="/personages" class="back-btn">←</a>
    </div>
    <div class="center">
      <nav>
        <img src="/assets/logoFN.png" class="logo" alt="Logo" />
      </nav>
    </div>
    <div class="right">
      <div class="user-info">
        <img src="<%= avatarImage || '/assets/question-mark.svg' %>" alt="User" class="user-profile" />
        <span class="username"><%= username %></span>
        <form method="GET" action="/logout">
          <button class="info-btn" title="Uitloggen">⎋</button>
        </form>
      </div>
    </div>
  </header>

  <!-- BLAUWE BALK BOVEN VAK -->
  <section class="top-section">
    <h1>KARAKTER INFO</h1>
  </section>

  <!-- INHOUD VAN KARAKTER -->
  <main class="karakter-container">
    <div class="karakter-info">
      <div class="karakter-img-box">
        <% if (isFavoriet) { %>
          <span class="favorite-star">⭐</span>
        <% } %>
        <img class="rarity-<%= karakter.rarity.toLowerCase() %>" src="<%= karakter.image %>" alt="Karakter Afbeelding" />
      </div>

      <div class="karakter-text-box">
        <h1><%= karakter.name %></h1>
        <p><%= karakter.description %></p>

        <div class="extra-info">
          <p><strong>Zeldzaamheid:</strong> <span class="rarity-<%= karakter.rarity.toLowerCase() %>"><%= karakter.rarity %></span></p>
          <p><strong>Set:</strong> <%= karakter.set %></p>
          <p><strong>Releasedatum:</strong> <%= karakter.releaseDate %></p>
        </div>

        <div class="karakter-actions">
          <form method="POST" action="/blacklist/<%= karakter.id %>">
            <input type="hidden" name="name" value="<%= karakter.name %>">
            <input type="hidden" name="image" value="<%= karakter.image %>">
            <input type="text" name="reason" placeholder="Reden voor blacklist" required>
            <button type="submit" class="blacklist-btn">❌</button>
          </form>

          <form method="POST" action="/favorieten/<%= karakter.id %>">
            <button type="submit" class="favorite-btn">❤️</button>
          </form>

          <form method="POST" action="/avatar/<%= karakter.id %>">
            <button class="set-profile" type="submit">
              <img src="/assets/add-user.png" alt="Set profiel" />
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>

  <% if (popupMessage) { %>
    <div id="popup-message" class="popup-message"><%= popupMessage %></div>
  <% } %>
</body>
</html>
