<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fortnite Personages</title>
  <link rel="stylesheet" href="/css/personages.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>
<body>

  <div class="navbar">
    <div class="left">
      <img src="/assets/logoFN.png" class="logo" alt="Logo" />
    </div>
    <div class="center">
      <nav>
        <a href="/personages" class="nav-btn active">Personages</a>
        <a href="/favorieten" class="nav-btn">Favorieten</a>
        <a href="/blacklist" class="nav-btn">Zwarte Lijst</a>
      </nav>
    </div>
    <div class="right">
      <div class="user-info">
        <img src="<%= avatarImage && avatarImage.trim() !== '' ? avatarImage : '/assets/question-mark.svg' %>" alt="User" class="user-profile" />
        <span class="username"><%= username %></span>
        <form method="POST" action="/logout" style="display: inline;">
          <button class="info-btn" title="Uitloggen">⎋</button>
        </form>
      </div>
    </div>
  </div>

  <main>
    <!-- Topbar -->
    <section class="top-section">
      <div class="top-container">
        <h1>Personages</h1>
        <form method="GET" action="/personages" class="search-container" id="searchForm" autocomplete="off">
          <input type="text" id="search" name="zoek" placeholder="Zoek" value="<%= zoek %>" autocomplete="off">
          <button class="play-btn" type="submit">Play</button>
          <select id="filter-rarity" name="rarity" onchange="this.form.submit()">
            <option value="">Alle Zeldzaamheden</option>
            <option value="common" <%=rarity==='common' ? 'selected' : '' %>>Common</option>
            <option value="uncommon" <%=rarity==='uncommon' ? 'selected' : '' %>>Uncommon</option>
            <option value="rare" <%=rarity==='rare' ? 'selected' : '' %>>Rare</option>
            <option value="epic" <%=rarity==='epic' ? 'selected' : '' %>>Epic</option>
            <option value="legendary" <%=rarity==='legendary' ? 'selected' : '' %>>Legendary</option>
            <option value="other" <%=rarity==='other' ? 'selected' : '' %>>Overige</option>
          </select>
        </form>
      </div>
      <!-- Nummering boven de grid -->
  <div class="paging-bar">
  <span class="paging-info">Totaal: <%= totalCharacters %> personages</span>
</div>

    </section>

    <!-- Grid met verticale pijlen -->
    <section class="characters-section">
      <div class="grid-row-flex">
        <!-- Linkerpijl -->
        <% if (page > 1) { %>
          <a href="/personages?page=<%= page-1 %>&zoek=<%= zoek %>&rarity=<%= rarity %>" class="paging-arrow paging-arrow-left" title="Vorige pagina">&#8592;</a>
        <% } else { %>
          <span class="paging-arrow paging-arrow-left disabled">&#8592;</span>
        <% } %>

        <!-- Personages Grid -->
        <div class="characters-grid" id="characters-grid">
          <% if (characters.length === 0) { %>
            <div class="no-results">
              <p>Geen personages gevonden.</p>
            </div>
          <% } else { %>
            <% characters.forEach(character => { 
              if (character.image && character.image.trim() !== '') { %>
                <a href="/personages/<%= character.id %>" class="character-link">
                  <div class="character-card rarity-<%= character.rarity.toLowerCase() %>">
                    <span class="rarity-label"><%= character.rarity %></span>
                    <% if (favorieteIds.includes(character.id)) { %>
                      <span class="favorite-star">⭐</span>
                    <% } %>
                    <img src="<%= character.image %>" alt="<%= character.name %>" class="character-img" />
                    <h3><%= character.name %></h3>
                  </div>
                </a>
            <%  } 
            }); %>
          <% } %>
        </div>

        <!-- Rechterpijl -->
        <% if (page < totalPages) { %>
          <a href="/personages?page=<%= page+1 %>&zoek=<%= zoek %>&rarity=<%= rarity %>" class="paging-arrow paging-arrow-right" title="Volgende pagina">&#8594;</a>
        <% } else { %>
          <span class="paging-arrow paging-arrow-right disabled">&#8594;</span>
        <% } %>
      </div>
    </section>

    <!-- PAGINATIEBALK onder de grid -->
    <% if (totalPages > 1) { %>
      <nav class="pagination-bar">
        <!-- Vorige pagina -->
        <% if (page > 1) { %>
          <a href="/personages?page=<%= page-1 %>&zoek=<%= zoek %>&rarity=<%= rarity %>" class="pagination-arrow" title="Vorige">&#171;</a>
        <% } else { %>
          <span class="pagination-arrow disabled">&#171;</span>
        <% } %>

        <!-- Eerste pagina altijd zichtbaar -->
        <% if (!pagination.includes(1)) { %>
          <a href="/personages?page=1&zoek=<%= zoek %>&rarity=<%= rarity %>" class="pagination-page">1</a>
          <% if (pagination[0] > 2) { %>
            <span class="pagination-ellipsis">...</span>
          <% } %>
        <% } %>

        <!-- Middenpagina's -->
        <% pagination.forEach(p => { %>
          <% if (p === page) { %>
            <span class="pagination-page current"><%= p %></span>
          <% } else { %>
            <a href="/personages?page=<%= p %>&zoek=<%= zoek %>&rarity=<%= rarity %>" class="pagination-page"><%= p %></a>
          <% } %>
        <% }); %>

        <!-- Laatste pagina altijd zichtbaar -->
        <% if (!pagination.includes(totalPages)) { %>
          <% if (pagination[pagination.length-1] < totalPages - 1) { %>
            <span class="pagination-ellipsis">...</span>
          <% } %>
          <a href="/personages?page=<%= totalPages %>&zoek=<%= zoek %>&rarity=<%= rarity %>" class="pagination-page"><%= totalPages %></a>
        <% } %>

        <!-- Volgende pagina -->
        <% if (page < totalPages) { %>
          <a href="/personages?page=<%= page+1 %>&zoek=<%= zoek %>&rarity=<%= rarity %>" class="pagination-arrow" title="Volgende">&#187;</a>
        <% } else { %>
          <span class="pagination-arrow disabled">&#187;</span>
        <% } %>
      </nav>
    <% } %>

    <% if (popupMessage) { %>
      <div id="popup-message" class="popup-message show">
        <%= popupMessage %>
      </div>
    <% } %>
  </main>

  <footer>
    &copy; Code Ninjas | AP Hogeschool
  </footer>

</body>
</html>
